{
  "name": "pinet",
  "version": "1.2.1",
  "description": "Yet another jsdocs template module",
  "main": "engine.js",
  "files": [
    "engine.js",
    "publish.js",
    "tags.js",
    "_internals/",
    "tmpl/",
    "static/"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.spec.js\"",
    "test:cov": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" \"tests/**/*.spec.js\"",
    "docs": "jsdoc -c jsdoc.json",
    "lint": "eslint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhershman1/pinet.git"
  },
  "keywords": [
    "jsdocs",
    "template",
    "pinet",
    "documentation",
    "docs"
  ],
  "author": "Dustin Hershman <dustinh17@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dhershman1/pinet/issues"
  },
  "homepage": "https://github.com/dhershman1/pinet#readme",
  "dependencies": {
    "highlight.js": "11.12.0",
    "kyanite": "3.2.0",
    "marked": "18.2.1"
  },
  "peerDependencies": {
    "jsdoc": "^4.0.0"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "jsdoc": "4.0.5",
    "neostandard": "0.14.1"
  }
}
