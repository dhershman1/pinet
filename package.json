{
  "name": "pinet",
  "version": "1.2.1",
  "description": "Yet another jsdocs template module",
  "main": "engine.js",
  "files": [
    "engine.js",
    "publish.js",
    "tags.js",
    "_internals/",
    "tmpl/",
    "static/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tape tests/engine.js \"tests/tmpl/*.js\" | tap-on",
    "docs": "jsdoc -c jsdoc.json",
    "lint": "eslint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhershman1/pinet.git"
  },
  "keywords": [
    "jsdocs",
    "template",
    "pinet",
    "documentation",
    "docs"
  ],
  "author": "Dustin Hershman <dustinh17@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dhershman1/pinet/issues"
  },
  "homepage": "https://github.com/dhershman1/pinet#readme",
  "dependencies": {
    "fs-extra": "11.2.0",
    "highlight.js": "11.10.0",
    "kyanite": "3.1.0",
    "marked": "14.1.2"
  },
  "peerDependencies": {
    "jsdoc": "^4.0.0"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "jsdoc": "4.0.5",
    "neostandard": "0.14.1",
    "tap-on": "1.0.0",
    "tape": "5.11.0"
  }
}
